      }
    ],
    "constraints": [],
    "indexes": [
      "CREATE INDEX ix_medication_encounter ON medication(encounter_id);"
    ]
  },
  {
    "name": "rule_version",
    "description": "Phiên bản bộ quy tắc theo module",
    "columns": [
      {
        "name": "id",
        "type": "uuid",
        "constraint": "PRIMARY KEY DEFAULT gen_random_uuid()",
        "description": "Mã nội bộ"
      },
      {
        "name": "code",
        "type": "varchar(60)",
        "constraint": "NOT NULL",
        "description": "Mã bộ quy tắc"
      },
      {
        "name": "version",
        "type": "integer",
        "constraint": "NOT NULL CHECK(version>0)",
        "description": "Số phiên bản"
      },
      {
        "name": "module",
        "type": "varchar(20)",
        "constraint": "NOT NULL CHECK(module IN ('diagnosis','lab_test','treatment','medsafety'))",
        "description": "Module"
      },
      {
        "name": "source_ref",
        "type": "text",
        "constraint": "NOT NULL",
        "description": "Nguồn chuyên môn, trang/mục và phiên bản"
      },
      {
        "name": "content_hash",
        "type": "varchar(64)",
        "constraint": "NOT NULL CHECK(content_hash ~ '^[a-f0-9]{64}$')",
        "description": "SHA256 nội dung đã duyệt"
      },
      {
        "name": "status",
        "type": "varchar(12)",
        "constraint": "NOT NULL CHECK(status IN ('draft','tested','approved','active','retired'))",
        "description": "Vòng đời"
      },
      {
        "name": "created_by",
        "type": "uuid",
        "constraint": "NOT NULL REFERENCES app_user(id)",
        "description": "Người tạo"
      },
      {
        "name": "created_at",
        "type": "timestamptz",
        "constraint": "NOT NULL DEFAULT now()",
        "description": "Thời điểm tạo"
      }
    ],
    "constraints": [
      "UNIQUE(code,version)"
    ],
    "indexes": [
      "CREATE UNIQUE INDEX ux_rule_active ON rule_version(code) WHERE status='active';"
    ]
  },
  {
    "name": "rule_approval",
    "description": "Bằng chứng duyệt ngoài hệ thống hoặc theo quyền được xác nhận",
    "columns": [
      {
        "name": "rule_version_id",
