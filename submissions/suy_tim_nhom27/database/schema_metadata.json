        "name": "display_name",
        "type": "text",
        "constraint": "NOT NULL",
        "description": "Tên hiển thị"
      }
    ],
    "constraints": [],
    "indexes": []
  },
  {
    "name": "medication",
    "description": "Thuốc hiện tại hoặc đơn dự kiến; không phải y lệnh tự động",
    "columns": [
      {
        "name": "id",
        "type": "uuid",
        "constraint": "PRIMARY KEY DEFAULT gen_random_uuid()",
