    "constraints": [
      "PRIMARY KEY(user_id,role_code)"
    ],
    "indexes": []
  },
  {
    "name": "patient_case",
    "description": "Hồ sơ synthetic, không lưu tên/CCCD/địa chỉ",
    "columns": [
      {
        "name": "id",
        "type": "uuid",
        "constraint": "PRIMARY KEY DEFAULT gen_random_uuid()",
        "description": "Mã nội bộ"
      },
      {
        "name": "synthetic_code",
        "type": "varchar(30)",
        "constraint": "NOT NULL UNIQUE CHECK (synthetic_code ~ '^SYN-[A-Z0-9-]{1,24}$')",
        "description": "Mã giả lập"
      },
      {
        "name": "age",
        "type": "smallint",
        "constraint": "NOT NULL CHECK (age BETWEEN 0 AND 120)",
        "description": "Tuổi tại tạo hồ sơ"
      },
      {
        "name": "sex",
        "type": "varchar(10)",
        "constraint": "NOT NULL CHECK (sex IN ('male','female','unknown'))",
        "description": "Giới tính"
      },
      {
        "name": "owner_id",
        "type": "uuid",
        "constraint": "NOT NULL REFERENCES app_user(id)",
        "description": "Bác sĩ phụ trách"
      },
      {
        "name": "revision",
        "type": "integer",
        "constraint": "NOT NULL DEFAULT 1 CHECK(revision>0)",
        "description": "Tăng khi dữ liệu nguồn thay đổi"
      },
      {
        "name": "created_at",
        "type": "timestamptz",
        "constraint": "NOT NULL DEFAULT now()",
        "description": "Thời điểm tạo"
      }
    ],
    "constraints": [],
    "indexes": [
      "CREATE INDEX ix_case_owner ON patient_case(owner_id);"
    ]
  },
  {
    "name": "case_access",
    "description": "Quyền đối với từng hồ sơ; một người có thể có nhiều phạm vi trên một ca",
    "columns": [
      {
        "name": "case_id",
        "type": "uuid",
        "constraint": "NOT NULL REFERENCES patient_case(id)",
        "description": "Ca bệnh"
      },
      {
        "name": "user_id",
        "type": "uuid",
        "constraint": "NOT NULL REFERENCES app_user(id)",
        "description": "Người được cấp quyền"
      },
      {
        "name": "access_scope",
        "type": "varchar(20)",
        "constraint": "NOT NULL CHECK(access_scope IN ('clinical','medsafety'))",
        "description": "Phạm vi dữ liệu"
      }
    ],
    "constraints": [
      "PRIMARY KEY(case_id,user_id,access_scope)"
    ],
    "indexes": []
  },
  {
    "name": "encounter",
    "description": "Lượt khám thuộc ca",
    "columns": [
      {
        "name": "id",
        "type": "uuid",
        "constraint": "PRIMARY KEY DEFAULT gen_random_uuid()",
        "description": "Mã nội bộ"
      },
      {
        "name": "case_id",
        "type": "uuid",
        "constraint": "NOT NULL REFERENCES patient_case(id)",
        "description": "Ca bệnh"
      },
      {
        "name": "occurred_at",
        "type": "timestamptz",
        "constraint": "NOT NULL",
        "description": "Thời gian khám"
      },
      {
        "name": "created_at",
        "type": "timestamptz",
        "constraint": "NOT NULL DEFAULT now()",
        "description": "Thời điểm tạo"
      }
    ],
    "constraints": [],
    "indexes": [
      "CREATE INDEX ix_encounter_case_time ON encounter(case_id,occurred_at DESC);"
    ]
  },
  {
    "name": "observation_type",
    "description": "Danh mục chỉ số và kiểu giá trị",
    "columns": [
      {
        "name": "code",
        "type": "varchar(60)",
        "constraint": "PRIMARY KEY",
        "description": "Mã biến kỹ thuật"
      },
      {
        "name": "label",
        "type": "text",
        "constraint": "NOT NULL",
        "description": "Tên hiển thị"
      },
      {
        "name": "value_kind",
        "type": "varchar(10)",
        "constraint": "NOT NULL CHECK(value_kind IN ('number','boolean','text'))",
        "description": "Kiểu giá trị"
      },
      {
        "name": "unit",
        "type": "varchar(40)",
        "constraint": "",
        "description": "Đơn vị chuẩn; null nếu không có"
      },
      {
        "name": "min_value",
        "type": "numeric",
        "constraint": "",
        "description": "Miền hợp lệ kỹ thuật, không phải ngưỡng cảnh báo"
      },
      {
        "name": "max_value",
        "type": "numeric",
        "constraint": "",
        "description": "Giới hạn trên nếu có"
      }
    ],
    "constraints": [
      "CHECK(min_value IS NULL OR max_value IS NULL OR min_value<=max_value)"
    ],
    "indexes": []
  },
  {
    "name": "observation",
    "description": "Mỗi dòng một giá trị, giữ lịch sử qua các lần đo",
    "columns": [
      {
        "name": "id",
        "type": "uuid",
        "constraint": "PRIMARY KEY DEFAULT gen_random_uuid()",
        "description": "Mã nội bộ"
      },
      {
        "name": "encounter_id",
        "type": "uuid",
        "constraint": "NOT NULL REFERENCES encounter(id)",
        "description": "Lượt khám"
      },
      {
        "name": "code",
        "type": "varchar(60)",
        "constraint": "NOT NULL REFERENCES observation_type(code)",
        "description": "Loại chỉ số"
      },
      {
        "name": "value_number",
        "type": "numeric",
        "constraint": "",
        "description": "Giá trị số"
      },
      {
        "name": "value_boolean",
        "type": "boolean",
        "constraint": "",
        "description": "Giá trị có/không"
      },
      {
        "name": "value_text",
        "type": "text",
        "constraint": "",
        "description": "Giá trị phân loại hoặc kết quả mô phỏng"
      },
      {
        "name": "status",
        "type": "varchar(20)",
        "constraint": "NOT NULL CHECK(status IN ('present','not_measured','unknown'))",
        "description": "Thiếu không đổi thành 0"
      },
      {
        "name": "observed_at",
        "type": "timestamptz",
        "constraint": "NOT NULL",
        "description": "Thời gian đo/đánh giá"
      },
      {
        "name": "source",
        "type": "varchar(30)",
        "constraint": "NOT NULL CHECK(source IN ('manual_synthetic','mock_his','mock_lis','mock_pacs'))",
        "description": "Nguồn synthetic"
      },
      {
        "name": "recorded_by",
        "type": "uuid",
        "constraint": "NOT NULL REFERENCES app_user(id)",
        "description": "Người nhập"
      },
      {
        "name": "created_at",
        "type": "timestamptz",
        "constraint": "NOT NULL DEFAULT now()",
        "description": "Thời điểm tạo"
      }
    ],
    "constraints": [
      "CHECK ((status = 'present' AND num_nonnulls(value_number,value_boolean,value_text)=1) OR (status<>'present' AND num_nonnulls(value_number,value_boolean,value_text)=0))"
    ],
    "indexes": [
      "CREATE INDEX ix_observation_latest ON observation(encounter_id,code,observed_at DESC);"
    ]
  },
  {
    "name": "ingredient",
