      {
        "name": "created_at",
        "type": "timestamptz",
        "constraint": "NOT NULL DEFAULT now()",
        "description": "Thời điểm tạo"
      }
    ],
    "constraints": [],
    "indexes": [
      "CREATE INDEX ix_evaluation_history ON evaluation(encounter_id,created_at DESC);"
    ]
  },
  {
    "name": "module_result",
    "description": "Đầu ra từng module của một lần đánh giá",
    "columns": [
      {
        "name": "id",
        "type": "uuid",
        "constraint": "PRIMARY KEY DEFAULT gen_random_uuid()",
        "description": "Mã nội bộ"
      },
      {
        "name": "evaluation_id",
        "type": "uuid",
        "constraint": "NOT NULL REFERENCES evaluation(id)",
