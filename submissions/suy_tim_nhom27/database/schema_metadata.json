      },
      {
        "name": "approved_content_hash",
        "type": "varchar(64)",
        "constraint": "NOT NULL CHECK(approved_content_hash ~ '^[a-f0-9]{64}$')",
        "description": "Hash nội dung đã duyệt"
      },
      {
        "name": "approved_at",
        "type": "timestamptz",
        "constraint": "NOT NULL",
        "description": "Thời điểm duyệt chuyên môn"
      },
      {
        "name": "recorded_by",
        "type": "uuid",
        "constraint": "NOT NULL REFERENCES app_user(id)",
        "description": "Người ghi nhận, không đồng nghĩa người duyệt"
      }
    ],
    "constraints": [],
    "indexes": []
  },
  {
    "name": "evaluation",
    "description": "Một lần đánh giá với ảnh chụp đầu vào bất biến",
    "columns": [
      {
        "name": "id",
        "type": "uuid",
        "constraint": "PRIMARY KEY DEFAULT gen_random_uuid()",
        "description": "Mã nội bộ"
      },
      {
        "name": "encounter_id",
        "type": "uuid",
