[
  {
    "name": "app_user",
    "description": "Tài khoản; không chứa thông tin bệnh nhân",
    "columns": [
      {
        "name": "id",
        "type": "uuid",
        "constraint": "PRIMARY KEY DEFAULT gen_random_uuid()",
        "description": "Mã nội bộ"
      },
      {
        "name": "username",
        "type": "varchar(80)",
        "constraint": "NOT NULL UNIQUE",
        "description": "Tên đăng nhập"
      },
      {
        "name": "password_hash",
        "type": "text",
        "constraint": "NOT NULL",
        "description": "Băm mật khẩu, không lưu mật khẩu thô"
      },
      {
        "name": "active",
        "type": "boolean",
        "constraint": "NOT NULL DEFAULT true",
        "description": "Cho phép đăng nhập"
      },
      {
        "name": "created_at",
        "type": "timestamptz",
        "constraint": "NOT NULL DEFAULT now()",
        "description": "Thời điểm tạo"
      }
    ],
    "constraints": [],
    "indexes": []
  },
  {
    "name": "role",
    "description": "Ba vai trò đã chốt",
    "columns": [
      {
        "name": "code",
        "type": "varchar(20)",
        "constraint": "PRIMARY KEY CHECK (code IN ('doctor','pharmacist','admin'))",
        "description": "Mã vai trò"
      }
    ],
    "constraints": [],
    "indexes": []
  },
  {
    "name": "user_role",
    "description": "Một tài khoản có thể có nhiều vai trò",
    "columns": [
      {
        "name": "user_id",
        "type": "uuid",
        "constraint": "NOT NULL REFERENCES app_user(id)",
        "description": "Tài khoản"
      },
      {
        "name": "role_code",
        "type": "varchar(20)",
        "constraint": "NOT NULL REFERENCES role(code)",
